{
  "name": "fastcomments-react",
  "version": "4.1.2",
  "description": "A React library for FastComments",
  "author": "winrid",
  "license": "MIT",
  "repository": "fastcomments/fastcomments-react",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "start": "tsup --watch",
    "prepare": "run-s build",
    "test": "run-s test:unit test:build",
    "test:unit": "vitest run",
    "test:build": "run-s build",
    "predeploy": "node build-demo.mjs",
    "deploy": "gh-pages -d demo-dist"
  },
  "peerDependencies": {
    "lodash": "*",
    "react": "*"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.159",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fastcomments-typescript": "^3.0.0",
    "gh-pages": "^6.0.0",
    "lodash": "^4.17.19",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist"
  ]
}
